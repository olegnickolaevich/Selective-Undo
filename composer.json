{
  "name": "olegnickolaevich/selective-undo",
  "description": "Development tools for the Selective Undo WordPress plugin. Not needed at runtime.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "php-stubs/wordpress-stubs": "^6.8",
    "php-stubs/wp-cli-stubs": "^2.11",
    "phpstan/phpstan": "^2.1",
    "szepeviktor/phpstan-wordpress": "^2.0"
  },
  "scripts": {
    "analyse": "phpstan analyse --memory-limit=1G"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
