msgid "A dedicated transactional connection to the primary database works and reaches the same database."
msgstr "Отдельное транзакционное соединение с основной базой данных работает и подключается к той же базе."

#. translators: %s: error code.
#: src/Application/Health/HealthService.php:110
#, php-format
msgid "The dedicated database connection failed (%s). Restoring is blocked."
msgstr "Отдельное соединение с базой данных не удалось (%s). Восстановление заблокировано."

#: src/Application/Health/HealthService.php:118
#: build/index.js:11
msgid "Recording"
msgstr "Журнал изменений"

