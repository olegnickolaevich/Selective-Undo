msgstr "Для Selective Undo нужен PHP 8.2 или новее. Плагин не работает."

#: src/Application/Health/HealthService.php:91
msgid "Database schema"
msgstr "Схема базы данных"

#. translators: %d: schema version.
#: src/Application/Health/HealthService.php:93
#, php-format
msgid "Version %d, all tables present."
msgstr "Версия %d, все таблицы на месте."

#. translators: %d: schema version.
#: src/Application/Health/HealthService.php:94
msgid "The schema is outdated. Open any admin page to run the update."
msgstr "Схема устарела. Откройте любую страницу админки, чтобы запустить обновление."

#: src/Application/Health/HealthService.php:103
msgid "Transactional tables"
msgstr "Транзакционные таблицы"

#: src/Application/Health/HealthService.php:105
msgid "Restoring requires InnoDB tables for posts and history. Recording continues, restoring is blocked."
msgstr "Для восстановления таблицы записей и истории должны быть InnoDB. Журнал изменений ведётся, восстановление заблокировано."

#: src/Application/Health/HealthService.php:106
msgid "The site uses SQLite. Restores run in transactions of the SQLite database."
msgstr "Сайт работает на SQLite. Восстановление выполняется в транзакциях базы SQLite."

#: src/Application/Health/HealthService.php:107
msgid "Posts and history tables use InnoDB."
msgstr "Таблицы записей и истории используют InnoDB."

#: src/Application/Health/HealthService.php:116
msgid "Compatibility mode"
msgstr "Режим совместимости"

#: src/Application/Health/HealthService.php:117
msgid "Restores use the WordPress database connection instead of a dedicated one, because the site runs on SQLite or SELECTIVE_UNDO_COMPAT_MODE is set. Every restored value is read back and checked before it is saved, but protection against a dropped connection in the middle of a restore is weaker. This mode is meant for demos and hosts that allow only one database connection."
msgstr "Восстановление использует соединение WordPress с базой данных вместо отдельного, потому что сайт работает на SQLite или задана константа SELECTIVE_UNDO_COMPAT_MODE. Каждое восстановленное значение перечитывается и проверяется до сохранения, но защита от обрыва соединения посреди восстановления слабее. Этот режим предназначен для демо и хостингов, где разрешено только одно соединение с базой."

#: src/Application/Health/HealthService.php:125
msgid "Restore connection"
msgstr "Соединение для восстановления"

#: src/Application/Health/HealthService.php:128
msgid "Restores use the WordPress database connection (compatibility mode)."
msgstr "Восстановление использует соединение WordPress с базой данных (режим совместимости)."

#: src/Application/Health/HealthService.php:129
msgid "A dedicated transactional connection to the primary database works and reaches the same database."
msgstr "Отдельное транзакционное соединение с основной базой данных работает и подключается к той же базе."

#. translators: %s: error code.
#: src/Application/Health/HealthService.php:130
#, php-format
msgid "The dedicated database connection failed (%s). Restoring is blocked."
msgstr "Отдельное соединение с базой данных не удалось (%s). Восстановление заблокировано."

