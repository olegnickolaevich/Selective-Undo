#. translators: %d: number of posts or pages.
#: build/index.js:2
#, js-format
msgid "%d item"
msgid_plural "%d items"
msgstr[0] "%d запись"
msgstr[1] "%d записи"
msgstr[2] "%d записей"

#: build/index.js:2
msgid "This field was changed again after the selected change. It is skipped so that the newer version is not lost."
msgstr "Это поле изменили ещё раз после выбранного изменения. Оно пропущено, чтобы не потерять более новую версию."

#: build/index.js:2
msgid "The item no longer exists. Deleted items cannot be restored in this version."
msgstr "Записи больше нет. Удалённые записи в этой версии не восстанавливаются."

#: build/index.js:2
msgid "You are not allowed to edit this item."
msgstr "У вас нет прав на редактирование этой записи."

#: build/index.js:2
msgid "The item is in the trash. Restore it from the trash first, then check again."
msgstr "Запись в корзине. Сначала восстановите её из корзины, затем проверьте ещё раз."

#: build/index.js:2
msgid "The previous value contains markup that your account is not allowed to publish. Ask an administrator to restore it."
msgstr "Прежнее значение содержит разметку, которую вашей учётной записи нельзя публиковать. Попросите восстановить его администратора."

#: build/index.js:2
msgid "The selected changes of this field do not follow each other. Select one change, or a continuous sequence of changes."
msgstr "Выбранные изменения этого поля не идут друг за другом. Выберите одно изменение или непрерывную последовательность изменений."

#: build/index.js:2
msgid "The same change was selected twice."
msgstr "Одно и то же изменение выбрано дважды."

#: build/index.js:2
msgid "The value was too large to be stored, so it cannot be restored."
msgstr "Значение было слишком большим для сохранения, поэтому его нельзя восстановить."

#: build/index.js:2
msgid "This change was recorded in an inconsistent situation, so automatic restore is not allowed."
msgstr "Это изменение записано в неоднозначной ситуации, поэтому автоматическое восстановление запрещено."

#: build/index.js:2
msgid "This change cannot be restored."
msgstr "Это изменение нельзя восстановить."

#: build/index.js:2
msgid "This is an informational event without values to restore."
msgstr "Это информационное событие, в нём нет значений для восстановления."

#: build/index.js:2
msgid "This field is not supported."
msgstr "Это поле не поддерживается."

#: build/index.js:2
msgid "This content type is no longer recorded. Enable it in the settings to restore it."
msgstr "Этот тип контента больше не отслеживается. Включите его в настройках, чтобы восстановить."

#: build/index.js:2
msgid "The component that restores this kind of data is not active."
msgstr "Компонент, который восстанавливает такие данные, не активен."

#: build/index.js:2
msgid "This change was recorded in an older, incompatible format."
msgstr "Это изменение записано в старом несовместимом формате."

#: build/index.js:2
msgid "The stored value has an unexpected type."
msgstr "У сохранённого значения неожиданный тип."

#: build/index.js:2
msgid "The stored value could not be read."
msgstr "Не удалось прочитать сохранённое значение."

#: build/index.js:2
msgid "The current value could not be read."
msgstr "Не удалось прочитать текущее значение."

#: build/index.js:2
msgid "The stored value is missing from the history."
msgstr "Сохранённого значения нет в истории."

#: build/index.js:2
msgid "The stored value is damaged (checksum mismatch). It will not be restored."
msgstr "Сохранённое значение повреждено (не совпадает контрольная сумма). Оно не будет восстановлено."

#: build/index.js:2
msgid "The stored value is damaged. It will not be restored."
msgstr "Сохранённое значение повреждено. Оно не будет восстановлено."

#: build/index.js:2
msgid "The stored value uses an unknown format."
