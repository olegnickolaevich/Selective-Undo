#. Plugin URI of the plugin
#: selective-undo.php
msgid "https://github.com/olegnickolaevich/Selective-Undo"
msgstr "https://github.com/olegnickolaevich/Selective-Undo"

#. Description of the plugin
#: selective-undo.php
msgid "Undo a specific content change and keep everything else. Selective restore of supported post fields with conflict checks."
msgstr "Отмените конкретное изменение контента и сохраните всё остальное. Выборочное восстановление поддерживаемых полей записей с проверкой конфликтов."

#. Author of the plugin
#: selective-undo.php
msgid "olegnickolaevich"
msgstr "olegnickolaevich"

