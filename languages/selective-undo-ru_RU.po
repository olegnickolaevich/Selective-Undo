msgid "https://github.com/olegnickolaevich"
msgstr "https://github.com/olegnickolaevich"

#: selective-undo.php:36
msgid "Selective Undo requires PHP 8.2 or newer. The plugin is inactive."
msgstr "Для Selective Undo нужен PHP 8.2 или новее. Плагин не работает."

